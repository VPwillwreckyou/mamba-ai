# Environment configuration for MAMBA
# Copy this file to .env and fill in real values.
# Do not commit real secrets to source control.

# AI provider
AI_PROVIDER=gemini
GEMINI_API_KEY=

# AI routing mode: local | cloud | auto
#   local  - always use the local Ollama server (offline, no key needed)
#   cloud  - always use the configured cloud provider (Groq)
#   auto   - use the configured cloud provider online, local Ollama offline
AI_MODE=auto

# Local Ollama model (used by local/auto modes)
OLLAMA_MODEL=qwen2.5:7b

# Optional model overrides
GEMINI_MODEL=

# Voice
MICROPHONE_INDEX=
VOICE_ENABLED=true
SPEECH_RATE=1.0
SPEECH_VOLUME=1.0
PUSH_TO_TALK=false

# Wake words
WAKE_WORDS=Mamba,Hey Mamba

# Language
DEFAULT_LANGUAGE=en

# Autonomy
AUTONOMY_MODE=maximum

# Twilio phone calls and SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DEFAULT_PHONE_NUMBER=
CALLER_ID=MAMBA AI

# Computer control
COMPUTER_CONTROL_ENABLED=true

# Indicated only
AI_API_PROVIDER=gemini
AI_API_KEY_REQUIRED=true

# Placeholders for future providers and integrations
# GEMINI_API_KEY=
# DISCORD_TOKEN=
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
